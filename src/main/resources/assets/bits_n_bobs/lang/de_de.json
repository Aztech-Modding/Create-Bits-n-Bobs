{
  "advancement.bits_n_bobs.dye_fluid_component": "Kunterbunte Flüssigkeitsbewegung!",
  "advancement.bits_n_bobs.dye_fluid_component.desc": "Färbe einen Flüssigkeitstank oder ein Rohr",
  "bits_n_bobs.ponder.chain_cog_changing_axis.header": "Achsenwechsel bei Zahnradketten",
  "bits_n_bobs.ponder.chain_cog_changing_axis.text_1": "Ketten können die Achse wechseln, wenn sie zwei große Zahnräder verbinden",
  "bits_n_bobs.ponder.chain_cog_changing_axis.text_2": "Sie müssen eine gemeinsame Tangente teilen, der die Kette folgen kann",
  "bits_n_bobs.ponder.chain_cog_flat.header": "Verbindung von Zahnrädern mit einer Kette",
  "bits_n_bobs.ponder.chain_cog_flat.text_1": "Ketten können verwendet werden, um 2 oder mehr Zahnräder zu verbinden",
  "bits_n_bobs.ponder.chain_cog_flat.text_2": "Übersetzungsverhältnisse bleiben über die gesamte Kette erhalten",
  "bits_n_bobs.ponder.chain_cog_flat.text_3": "2x UPM",
  "bits_n_bobs.ponder.chain_cog_flat.text_4": "1x UPM",
  "bits_n_bobs.ponder.dyed_pipes.header": "Rohre färben",
  "bits_n_bobs.ponder.dyed_pipes.text_1": "Farblose Rohre verbinden sich automatisch, wenn nebeneinander.",
  "bits_n_bobs.ponder.dyed_pipes.text_2": "Gefärbte Rohre werden sich nur automatisch mit Rohren der gleichen Farbe verbinden.",
  "bits_n_bobs.ponder.dyed_pipes.text_3": "Farblose Rohre wiederum, werden sich mit Rohren aller Farben verbinden.",
  "bits_n_bobs.ponder.dyed_pipes.text_4": "Das Platzieren eines Rohres mit Farbe in der Zweithand, wird das Rohr sofort färben.",
  "bits_n_bobs.ponder.dyed_tank.header": "Flüssigkeitstank färben",
  "bits_n_bobs.ponder.dyed_tank.text_1": "Flüssigkeitstanks können mit Farbstoff umgefärbt werden.",
  "bits_n_bobs.ponder.dyed_tank.text_2": "Schleiche, um nur einen einzigen Block in einem Flüssigkeitstank zu färben.",
  "bits_n_bobs.ponder.dyed_tank.text_3": "Gefärbte Flüssigkeitstanks werden sich nicht mit Flüssigkeitstanks einer anderen Farbe verbinden.",
  "bits_n_bobs.ponder.dyed_tank.text_4": "Rohre und Flüssigkeitstanks der gleichen Farbe, werden sich wie gewohnt verbinden.",
  "bits_n_bobs.ponder.dyed_tank.text_5": "Rohre einer anderen Farbe, werden sich wiederum nicht automatisch verbinden.",
  "bits_n_bobs.ponder.dyed_tank.text_6": "Farblose Rohre, werden sich automatisch mit Rohren und Flüssigkeitstanks aller Farben verbinden.",
  "bits_n_bobs.ponder.girder_strut.header": "Platziere Trägerstreben",
  "bits_n_bobs.ponder.girder_strut.text_1": "Streben können genutzt werden, um zwei Blöcke zu verbinden",
  "bits_n_bobs.ponder.girder_strut.text_2": "Streben können mit verschiedenen Winkeln platziert werden",
  "bits_n_bobs.ponder.girder_strut.text_3": "Streben können aber nur in 2 Achsen verschoben sein, das heißt, sie können sich nicht biegen",
  "bits_n_bobs.ponder.large_nixie_tube.header": "Nutze große Nixie-Röhre",
  "bits_n_bobs.ponder.large_nixie_tube.text_1": "Dies ist eine große Nixie-Röhre, sie kann zum Anzeigen von benutzerdefinierten Text und Symbolen genutzt wird",
  "bits_n_bobs.ponder.large_nixie_tube.text_2": "Große Nixie-Röhren können kombiniert werden, wenn sie in kompatiblen Reihen sind",
  "bits_n_bobs.ponder.large_nixie_tube.text_3": "Ein Schraubenschlüssel kann genutzt werden, um den Anzeigemodus der Nixie-Röhre zu ändern",
  "bits_n_bobs.ponder.large_nixie_tube.text_4": "Farbstoff kann genutzt werden, um die Farbe aller verbundenen Röhren in eins zu ändern",
  "bits_n_bobs.ponder.nixie_board.header": "Nutze Nixie-Boards",
  "bits_n_bobs.ponder.nixie_board.text_1": "Dies ist ein Nixie-Board. Es kann genutzt werden, um Text darzustellen",
  "bits_n_bobs.ponder.nixie_board.text_2": "Ein Nixie-Board wird erweitert, wenn es mit anderen Nachbarn verbunden ist",
  "bits_n_bobs.ponder.nixie_board.text_3": "Drüber oder drunter platzierte Boards, werden sich zu einem größeren Board verbinden",
  "bits_n_bobs.ponder.nixie_board.text_4": "Klemmbretter, Anzeige-Links oder Namensschilder können genutzt werden, um den angezeigten Text zu ändern",
  "bits_n_bobs.ponder.nixie_board.text_5": "Ein Schraubenschlüssel kann genutzt werden, um durch die Anzeigemodi zu iterieren",
  "bits_n_bobs.ponder.nixie_board.text_6": "Verschiedene Anzeigemodi unterstützen mehr Zeichen und mehrere Zeilen",
  "bits_n_bobs.ponder.nixie_board.text_7": "Farbstoff kann genutzt werden, um die Farbe aller verbundenen Boards zu ändern",
